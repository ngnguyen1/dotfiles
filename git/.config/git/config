[alias]
  # status / staging
  s = status
  st = status -s
  a = add
  aa = add --all
  ap = add --patch
  unstage = restore --staged
  rs = restore

  # commit
  c = commit -v
  cm = commit -m
  ca = commit -v --amend
  cam = commit -v --amend --no-edit
  cf = commit --fixup
  fix = commit --fixup
  last = log -1 HEAD

  # branch / switch
  b = branch
  bd = branch -d
  bdf = branch -D
  co = checkout
  cob = checkout -b
  sw = switch
  swc = switch -c

  # diff
  d = diff
  ds = diff --staged
  dw = diff --word-diff

  # log
  l = log --oneline --graph --decorate
  la = log --oneline --graph --decorate --all
  lo = log --oneline -20
  lp = log --patch
  who = shortlog -sne

  # remote / sync
  f = fetch
  fa = fetch --all --prune
  p = push
  pf = push --force-with-lease
  pl = pull
  plr = pull --rebase
  psup = push --set-upstream origin HEAD
  sync = !git fetch --all --prune && git rebase

  # rebase / merge
  rb = rebase
  rbi = rebase -i
  rba = rebase --abort
  rbc = rebase --continue
  rbs = rebase --skip
  m = merge
  ma = merge --abort
  mc = merge --continue

  # stash
  sta = stash push
  stp = stash pop
  stl = stash list
  std = stash drop
  sts = stash show -p

  # reset / clean
  r = reset
  rh = reset --hard
  rsoft = reset --soft HEAD~1
  cleanf = clean -fd

  # cherry-pick / worktree / blame
  cp = cherry-pick
  cpa = cherry-pick --abort
  cpc = cherry-pick --continue
  wt = worktree
  bl = blame -w

  # housekeeping
  aliases = !git config --get-regexp '^alias\\.' | sed 's/alias\\.//' | sort
  root = rev-parse --show-toplevel
  prune-merged = !git branch --merged | grep -vE '^\\*|^\\s*(main|master|develop)$' | xargs -r git branch -d
